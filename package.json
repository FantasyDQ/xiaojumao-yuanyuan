{
  "name": "desktop-pet",
  "version": "2.1.0",
  "description": "萌系小动物桌面宠物 - Electron + Web",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "electron make-icon.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.desktoppet.xiaoju",
    "productName": "小橘猫缘缘",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "history-db.js",
      "src/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "python",
        "to": "python"
      },
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小橘猫缘缘",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "小橘猫缘缘-免安装版-${version}.exe"
    },
    "publish": null
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "pdf-parse": "^2.4.5",
    "sql.js": "^1.14.2"
  }
}